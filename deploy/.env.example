DOMAIN=your-domain.example
# URL-safe random hex only (used inside DATABASE_URL).
DB_PASSWORD=replace-with-64-random-hex-characters
AUTH_SECRET=replace-with-at-least-32-random-characters
# User UUID -> SHA-256 access-key digest, for invitation-key accounts. May stay {}
# when everyone signs up with a password.
AUTH_ACCESS_KEYS={}
# true: anyone who can reach the site can create an account at /signup (email,
# password, recovery codes). false: invitation keys only.
SIGNUP_ENABLED=true
LLM_PROVIDER=groq
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=35
MEMORY_TIMEOUT_SECONDS=8
MEMORY_EXTRACTION=auto
# Model for the per-message memory call; empty = the chat model. A smaller model
# (e.g. openai/gpt-oss-20b) is cheaper and, on Groq's free tier, draws on its own
# daily token limit instead of the chat model's. Check its extractions before
# switching.
MEMORY_MODEL=


# Per-account fixed UTC minute/day windows. The day budget is in tokens: each
# call is charged a high estimate up front, then trued up to the provider's count.
ACCOUNT_REQUESTS_PER_MINUTE=6
ACCOUNT_DAILY_TOKEN_BUDGET=60000

# --- Features ---
# Ask My Team (POST /api/team/ask) ships switched off: no screen calls it yet and
# it is the most expensive route. Set to true only once a UI exists.
TEAM_ENABLED=false

# --- Operations ---
# Account ids allowed to see /api/admin/dashboard and the full /api/health/detail.
# EMPTY MEANS NOBODY. Your id is "id" in /api/users/me once signed in.
ADMIN_ACCOUNTS=[]
# Alerting. Set at least one channel or nothing will ever reach you.
# Any webhook that accepts JSON works: Discord, Slack, ntfy.
ALERT_WEBHOOK_URL=
# Or Telegram: @BotFather for the token, @userinfobot for the chat id.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Alert once this many unhandled errors have happened since start.
ALERT_ERROR_THRESHOLD=3

# Managed hosting (see docs/public-free-host-runbook.md).
ENVIRONMENT=production
DEBUG=false
AUTH_REQUIRED=true
GUEST_ENABLED=true
MOBILE_ENABLED=false
PUBLIC_DAILY_TOKEN_BUDGET=100000
PUBLIC_GUEST_SESSIONS_PER_DAY=200
FRONTEND_URL=https://fareeqai.pages.dev
DATABASE_URL=postgresql+psycopg://user:password@database.example/db?sslmode=require
MEMORY_STORE_SENSITIVE=false
DOCUMENT_SEMANTIC_SEARCH=false
PUSH_ENABLED=false
VOICE_ENABLED=false
TTS_ENABLED=false
