{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "design-preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SAMPLE_MODE": "true",
        "EXPO_NO_DOTENV": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fareeqai.pages.dev",
        "EXPO_PUBLIC_SAMPLE_MODE": "false",
        "EXPO_NO_DOTENV": "1"
      }
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
